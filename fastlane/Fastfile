# App Store Connect steps used by the workflows. Everything comes from
# environment variables (filled from the GitHub environment secrets); nothing
# app-specific is stored in this public repo.
#
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8   App Store Connect API key
#   BUNDLE_ID                                 the app's bundle identifier

default_platform(:ios)

platform :ios do
  # The .p8 text as a clean PEM: secrets pasted on one line, with literal "\n"
  # or with Windows line ends otherwise fail with "invalid curve name".
  def p8_content
    raw = ENV.fetch("ASC_KEY_P8").gsub("\\n", "\n")
    body = raw.gsub(/-----[^-]+-----/, "").gsub(/\s+/, "")
    "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
  end

  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: p8_content,
      duration: 1200
    )
  end

  # Key works and the app record exists in App Store Connect.
  lane :verify_asc do
    asc_key
    build = latest_testflight_build_number(app_identifier: ENV.fetch("BUNDLE_ID"), initial_build_number: 0)
    version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]
    UI.success("App Store Connect OK - latest TestFlight build: #{version || '-'} (#{build})")
  end

  # Upload a signed .ipa to TestFlight (does not wait for Apple's processing).
  lane :upload_testflight do
    asc_key
    upload_to_testflight(
      ipa: ENV.fetch("IPA_PATH"),
      app_identifier: ENV.fetch("BUNDLE_ID"),
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"].to_s.strip.empty? ? nil : ENV["CHANGELOG"]
    )
  end

  # Submit a build that is already on TestFlight to App Store review.
  lane :submit_production do
    asc_key
    app = ENV.fetch("BUNDLE_ID")
    build = ENV["BUILD_NUMBER"].to_s.strip
    version = ENV["APP_VERSION"].to_s.strip
    if build.empty? && version.empty?
      build = latest_testflight_build_number(app_identifier: app).to_s
      version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION].to_s
    elsif build.empty? || version.empty?
      UI.user_error!("Give both version and build_number, or leave both empty for the latest TestFlight build")
    end
    UI.message("Submitting version #{version} (build #{build}) for App Store review")

    notes = ENV["RELEASE_NOTES"].to_s.strip
    empty_metadata = File.join(ENV.fetch("RUNNER_TEMP", "/tmp"), "empty-metadata")
    FileUtils.mkdir_p(empty_metadata)

    deliver(
      app_identifier: app,
      app_version: version,
      build_number: build,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: notes.empty?,
      metadata_path: empty_metadata,
      release_notes: notes.empty? ? nil : { "default" => notes },
      ignore_language_directory_validation: true,
      submit_for_review: true,
      automatic_release: ENV["AUTO_RELEASE"] == "true",
      phased_release: ENV["PHASED_RELEASE"] == "true",
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success("Submitted #{version} (#{build}) for review")
  end
end
